        conn.commit()
        flash("Категория удалена.", "success")

    cursor.close()
    conn.close()
    return redirect(url_for("admin.menu"))


@admin.route("/menu")
@login_required
def menu():
    restaurant = require_restaurant()
    if not restaurant:
        return redirect(url_for("admin.dashboard"))

    conn = get_db()
    cursor = conn.cursor(dictionary=True)
    cursor.execute(
        """
        SELECT m.*, c.name AS category_name
        FROM menu m
        LEFT JOIN categories c ON m.category_id = c.id
        WHERE m.restaurant_id = %s
        ORDER BY c.sort_order, c.name, m.sort_order, m.name
        """,
        (restaurant["id"],),
    )
    menu_items = cursor.fetchall()
    cursor.execute(
        "SELECT * FROM categories WHERE restaurant_id = %s ORDER BY sort_order, name",
        (restaurant["id"],),
    )
    categories = cursor.fetchall()
    cursor.close()
    conn.close()
    return render_template(
        "admin/menu.html",
        menu_items=menu_items,
        categories=categories,
        restaurant=restaurant,
    )


@admin.route("/menu/add", methods=["GET", "POST"])
@login_required
def add_menu_item():
    restaurant = require_restaurant()
    if not restaurant:
        return redirect(url_for("admin.dashboard"))

    if request.method == "GET":
        return redirect(url_for("admin.menu"))

    if request.method == "POST":
        name = request.form.get("name", "").strip()
        description = request.form.get("description", "").strip() or None
        ingredients = request.form.get("ingredients", "").strip() or None
        price = request.form.get("price")
        amount = request.form.get("amount", "").strip() or None
        category_id = request.form.get("category_id")
        is_available = form_checkbox_value("is_available")
        image = request.files.get("image")
        image_path = None

        if name and price and category_id:
            if not menu_item_name_is_available(name, restaurant["id"]):
                flash("Блюдо с таким названием уже существует.", "error")
                return redirect(url_for("admin.menu"))

            try:
                category_id = int(category_id)
            except (TypeError, ValueError):
                flash("Категория должна быть корректным числом.", "error")
                return redirect(url_for("admin.add_menu_item"))

            if not category_belongs_to_restaurant(category_id, restaurant["id"]):
                flash("Категория не принадлежит выбранному ресторану.", "error")
                return redirect(url_for("admin.add_menu_item"))

            if image and allowed_file(image.filename):
                image_path = save_menu_image(image, restaurant)

            conn = get_db()
            cursor = conn.cursor()
            try:
                try:
                    cursor.execute(
                        """
                        INSERT INTO menu (restaurant_id, name, description, ingredients, price, amount, image, category_id, is_available)
                        VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)
                        """,
                        (restaurant["id"], name, description, ingredients, int(price), amount, image_path, category_id, is_available),
                    )
                except Exception as inner_exc:
                    message = str(inner_exc)
                    if "Unknown column" in message and "ingredients" in message:
                        cursor.execute(
                            """
                            INSERT INTO menu (restaurant_id, name, description, price, amount, image, category_id, is_available)
                            VALUES (%s, %s, %s, %s, %s, %s, %s, %s)
                            """,
                            (restaurant["id"], name, description, int(price), amount, image_path, category_id, is_available),
                        )
                    else:
                        raise
                conn.commit()
                flash("Блюдо добавлено.", "success")
                return redirect(url_for("admin.menu"))
            except Exception as exc:
                conn.rollback()
                message = str(exc)
                if "1062" in message or "Duplicate entry" in message:
                    flash("Блюдо с таким названием уже существует.", "error")
                else:
                    flash(f"Не удалось добавить блюдо: {exc}", "error")
            finally:
                cursor.close()
                conn.close()

    conn = get_db()
    cursor = conn.cursor(dictionary=True)
    cursor.execute(
        "SELECT * FROM categories WHERE restaurant_id = %s ORDER BY sort_order, name",
        (restaurant["id"],),
    )
    categories = cursor.fetchall()
    cursor.close()
    conn.close()

    return redirect(url_for("admin.menu"))


@admin.route("/menu/edit/<int:id>", methods=["GET", "POST"])
@login_required
def edit_menu_item(id):
    restaurant = require_restaurant()
    if not restaurant:
        return redirect(url_for("admin.dashboard"))

    if request.method == "GET":
        return redirect(url_for("admin.menu"))

    conn = get_db()
    cursor = conn.cursor(dictionary=True)

    if request.method == "POST":
        name = request.form.get("name", "").strip()
        description = request.form.get("description", "").strip() or None
        ingredients = request.form.get("ingredients", "").strip() or None
        price = request.form.get("price")
        amount = request.form.get("amount", "").strip() or None
        category_id = request.form.get("category_id")
        is_available = form_checkbox_value("is_available")
        image = request.files.get("image")
        image_path = request.form.get("current_image")

        if name and price and category_id:
            if not menu_item_name_is_available(name, restaurant["id"], exclude_id=id):
                flash("Блюдо с таким названием уже существует.", "error")
                cursor.close()
                conn.close()
                return redirect(url_for("admin.menu"))

            try:
                category_id = int(category_id)
            except (TypeError, ValueError):
                flash("Категория должна быть корректным числом.", "error")
                cursor.close()
                conn.close()
                return redirect(url_for("admin.edit_menu_item", id=id))

            if not category_belongs_to_restaurant(category_id, restaurant["id"]):
                flash("Категория не принадлежит выбранному ресторану.", "error")
                cursor.close()
                conn.close()
                return redirect(url_for("admin.edit_menu_item", id=id))

            if image and allowed_file(image.filename):
                delete_menu_image(image_path)
                image_path = save_menu_image(image, restaurant)

            try:
                try:
                    cursor.execute(
                        """
                        UPDATE menu
                        SET name = %s, description = %s, ingredients = %s, price = %s, amount = %s, image = %s,
                            category_id = %s, is_available = %s
                        WHERE id = %s AND restaurant_id = %s
                        """,
                        (
                            name, description, ingredients, int(price), amount, image_path, category_id,
                            is_available, id, restaurant["id"],
                        ),
                    )
                except Exception as inner_exc:
                    message = str(inner_exc)
                    if "Unknown column" in message and "ingredients" in message:
                        cursor.execute(
                            """
                            UPDATE menu
                            SET name = %s, description = %s, price = %s, amount = %s, image = %s,
                                category_id = %s, is_available = %s
                            WHERE id = %s AND restaurant_id = %s
                            """,
                            (
                                name, description, int(price), amount, image_path, category_id,
                                is_available, id, restaurant["id"],
                            ),
                        )
                    else:
                        raise
                conn.commit()
                flash("Блюдо обновлено.", "success")
                cursor.close()
                conn.close()
                return redirect(url_for("admin.menu"))
            except Exception as exc:
                conn.rollback()
                message = str(exc)
                if "1062" in message or "Duplicate entry" in message:
                    flash("Блюдо с таким названием уже существует.", "error")
                else:
                    flash(f"Не удалось обновить блюдо: {exc}", "error")

    cursor.execute(
        "SELECT * FROM menu WHERE id = %s AND restaurant_id = %s",
        (id, restaurant["id"]),
    )
    menu_item = cursor.fetchone()
    cursor.execute(
        "SELECT * FROM categories WHERE restaurant_id = %s ORDER BY sort_order, name",
        (restaurant["id"],),
    )
    categories = cursor.fetchall()
    cursor.close()
    conn.close()

    if not menu_item:
        abort(404)

    return redirect(url_for("admin.menu"))


@admin.route("/menu/toggle-available/<int:id>", methods=["POST"])
@login_required
def toggle_menu_item_available(id):
    restaurant = require_restaurant()
    if not restaurant:
        return redirect(url_for("admin.dashboard"))

    if not menu_item_belongs_to_restaurant(id, restaurant["id"]):
        abort(404)

    is_available = 1 if request.form.get("is_available") == "on" else 0

    conn = get_db()
    cursor = conn.cursor()
    cursor.execute(
        "UPDATE menu SET is_available = %s WHERE id = %s AND restaurant_id = %s",
        (is_available, id, restaurant["id"]),
    )
    conn.commit()
    cursor.close()
    conn.close()

    flash("Блюдо включено." if is_available else "Блюдо выключено.", "success")
    return redirect(url_for("admin.menu"))


@admin.route("/menu/delete/<int:id>", methods=["POST"])
@login_required
def delete_menu_item(id):
    restaurant = require_restaurant()
    if not restaurant:
        return redirect(url_for("admin.dashboard"))

    conn = get_db()
    cursor = conn.cursor(dictionary=True)
    cursor.execute(
        "SELECT image FROM menu WHERE id = %s AND restaurant_id = %s",
        (id, restaurant["id"]),
    )
    item = cursor.fetchone()

    if item and item["image"]:
        delete_menu_image(item["image"])

    cursor.execute(
        "DELETE FROM menu WHERE id = %s AND restaurant_id = %s",
        (id, restaurant["id"]),
    )
    conn.commit()
    cursor.close()
    conn.close()

    flash("Блюдо удалено.", "success")
    return redirect(url_for("admin.menu"))
