    cursor = conn.cursor()
    cursor.execute(
        "SELECT COUNT(*) FROM menu WHERE category_id = %s AND restaurant_id = %s",
        (id, restaurant["id"]),
    )
    count = cursor.fetchone()[0]

    if count > 0:
        flash("Нельзя удалить категорию, в которой есть блюда.", "error")
